[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-readeck
Exec=harbour-readeck
Name=Readeck
Name[de]=Readeck
# A share always lands in the already-running instance rather than
# spawning a second one.
X-Nemo-Single-Instance=yes
X-Share-Methods=link

[X-Share Method link]
Description=Save to Readeck
Description[de]=In Readeck speichern
Capabilities=text/x-url;text/uri-list;text/plain
SupportsMultipleFiles=no

[X-Sailjail]
OrganizationName=harbour-readeck
ApplicationName=harbour-readeck
Permissions=Internet;WebView
